{
  "purity": [
    {
      "rule": "P6",
      "path": "src/roles/governor.ts",
      "until": "DEFERRED"
    }
  ],
  "wired": [
    {
      "path": "src/roles/prompts/reviewer.ts",
      "until": "DEFERRED"
    }
  ],
  "events": [],
  "events_observe_only": [
    "batch.started",
    "bisect.started",
    "contracts.committed",
    "governor.fallback",
    "integration.started",
    "merge.conflict",
    "plan.ready",
    "plan.started",
    "rate_limit.backoff",
    "replan.started",
    "run.budget.exceeded",
    "run.budget.warning",
    "run.resumed",
    "scope.checked",
    "task.replanned",
    "task.session.ended",
    "task.worktree.created"
  ],
  "settings": [
    {
      "key": "execution.strategy",
      "until": "DEFERRED"
    },
    {
      "key": "git.branch_prefix",
      "until": "DEFERRED"
    },
    {
      "key": "roles.governor.*",
      "until": "DEFERRED"
    },
    {
      "key": "roles.reviewer.backend",
      "until": "DEFERRED"
    },
    {
      "key": "roles.reviewer.effort",
      "until": "DEFERRED"
    },
    {
      "key": "roles.reviewer.enabled",
      "until": "DEFERRED"
    },
    {
      "key": "roles.reviewer.model",
      "until": "DEFERRED"
    },
    {
      "key": "sandbox.network",
      "until": "DEFERRED"
    }
  ],
  "dead": [
    {
      "symbol": "aggregateLedger",
      "path": "src/ledger/index.ts",
      "until": "DEFERRED"
    },
    {
      "symbol": "validateGovernorTool",
      "path": "src/roles/governor-tools.ts",
      "until": "DEFERRED"
    },
    {
      "symbol": "runGovernorSemanticLint",
      "path": "src/roles/governor.ts",
      "until": "DEFERRED"
    },
    {
      "symbol": "buildReviewerPrompt",
      "path": "src/roles/prompts/reviewer.ts",
      "until": "DEFERRED"
    },
    {
      "symbol": "appendRouteOutcome",
      "path": "src/roles/router.ts",
      "until": "DEFERRED"
    }
  ]
}
