{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvReport",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "version": {
      "type": "string"
    },
    "pin_matches": {
      "type": "boolean"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "ok",
    "pin_matches",
    "problems"
  ],
  "additionalProperties": false
}
