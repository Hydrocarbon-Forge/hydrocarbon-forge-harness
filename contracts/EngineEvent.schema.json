{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EngineEvent",
  "type": "object",
  "properties": {
    "v": {
      "const": 1
    },
    "seq": {
      "type": "number"
    },
    "ts": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^r_[A-Z2-7]{12}$"
    },
    "type": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "v",
    "seq",
    "ts",
    "run_id",
    "type"
  ],
  "additionalProperties": false
}
