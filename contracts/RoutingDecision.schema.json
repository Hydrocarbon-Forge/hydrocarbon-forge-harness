{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoutingDecision",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "solo",
        "plan"
      ]
    },
    "task_class": {
      "type": "string"
    },
    "planner_route": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "needs_clarification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "mode",
    "rationale"
  ],
  "additionalProperties": false
}
