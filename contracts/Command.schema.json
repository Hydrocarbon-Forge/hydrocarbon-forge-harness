{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command",
  "type": "object",
  "properties": {
    "run": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "timeout_s": {
      "type": "number"
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "run",
    "timeout_s"
  ],
  "additionalProperties": false
}
