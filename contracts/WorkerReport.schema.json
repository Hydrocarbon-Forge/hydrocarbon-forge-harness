{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkerReport",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9_-]{0,31}$"
    },
    "generation": {
      "type": "number"
    },
    "attempt": {
      "type": "number"
    },
    "session_id": {
      "type": "string"
    },
    "backend": {
      "type": "string",
      "enum": [
        "claude",
        "opencode",
        "agy",
        "fake"
      ]
    },
    "model": {
      "type": "string"
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "failure_class": {
      "type": "string",
      "enum": [
        "verify_failed",
        "scope_violation",
        "protected_modified",
        "budget_exceeded",
        "timeout",
        "worker_crashed",
        "permission_denied",
        "rate_limited",
        "merge_conflict",
        "integration_failed",
        "spec_invalid"
      ]
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "claude",
            "opencode",
            "agy",
            "fake"
          ]
        },
        "model": {
          "type": "string"
        },
        "input_tokens": {
          "type": "number"
        },
        "output_tokens": {
          "type": "number"
        },
        "cache_read_tokens": {
          "type": "number"
        },
        "cache_write_tokens": {
          "type": "number"
        },
        "reasoning_tokens": {
          "type": "number"
        },
        "cost_usd": {
          "type": "number"
        },
        "cost_source": {
          "type": "string",
          "enum": [
            "reported",
            "computed"
          ]
        },
        "at": {
          "type": "string"
        }
      },
      "required": [
        "backend",
        "model",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "cost_source",
        "at"
      ],
      "additionalProperties": false
    },
    "duration_ms": {
      "type": "number"
    },
    "verify": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string"
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "timed_out": {
            "type": "boolean"
          },
          "duration_ms": {
            "type": "number"
          },
          "stdout_tail": {
            "type": "string"
          },
          "stderr_tail": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "cmd",
          "exit_code",
          "timed_out",
          "duration_ms",
          "stdout_tail",
          "stderr_tail",
          "truncated"
        ],
        "additionalProperties": false
      }
    },
    "denials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_message": {
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "generation",
    "attempt",
    "session_id",
    "backend",
    "model",
    "status",
    "files_changed",
    "usage",
    "duration_ms",
    "verify",
    "denials",
    "final_message"
  ],
  "additionalProperties": false
}
