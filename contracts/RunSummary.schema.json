{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunSummary",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^r_[A-Z2-7]{12}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "finished",
        "planned",
        "failed",
        "paused",
        "cancelled"
      ]
    },
    "pause_reason": {
      "type": "string",
      "enum": [
        "needs_approval",
        "permission_denied",
        "budget_exhausted",
        "timeout",
        "rate_limited",
        "user_cancel",
        "needs_human",
        "backend_unavailable"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "default": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "generation": {
            "type": "number"
          },
          "failure_class": {
            "type": "string",
            "enum": [
              "verify_failed",
              "scope_violation",
              "protected_modified",
              "budget_exceeded",
              "timeout",
              "worker_crashed",
              "permission_denied",
              "rate_limited",
              "merge_conflict",
              "integration_failed",
              "spec_invalid"
            ]
          }
        },
        "required": [
          "state",
          "generation"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "total_usd": {
          "type": "number"
        },
        "by_role": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "total_usd",
        "by_role"
      ],
      "additionalProperties": false
    },
    "branch": {
      "type": "string"
    },
    "exit_code": {
      "type": "number"
    },
    "merged": {
      "type": "boolean"
    },
    "base_branch": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_changed_total": {
      "type": "number"
    },
    "next": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_class": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "drafts_dir": {
      "type": "string"
    },
    "not_merged_reason": {
      "type": "string"
    },
    "verification": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped",
        "not_run"
      ]
    },
    "verification_note": {
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "status",
    "tasks",
    "usage",
    "exit_code"
  ],
  "additionalProperties": false
}
