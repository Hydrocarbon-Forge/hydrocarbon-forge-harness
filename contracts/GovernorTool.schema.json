{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovernorTool",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "start_run"
        },
        "args": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "solo",
                "plan"
              ]
            },
            "permission_mode": {
              "type": "string",
              "enum": [
                "default",
                "plan",
                "acceptEdits",
                "dontAsk",
                "bypassPermissions"
              ]
            }
          },
          "required": [
            "request"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "plan_only"
        },
        "args": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string"
            }
          },
          "required": [
            "request"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "resume_run"
        },
        "args": {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "pattern": "^r_[A-Z2-7]{12}$"
            }
          },
          "required": [
            "run_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "run_status"
        },
        "args": {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "pattern": "^r_[A-Z2-7]{12}$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "show_cost"
        },
        "args": {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "pattern": "^r_[A-Z2-7]{12}$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "cancel_run"
        },
        "args": {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "pattern": "^r_[A-Z2-7]{12}$"
            }
          },
          "required": [
            "run_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "const": "ask_user"
        },
        "args": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "args"
      ],
      "additionalProperties": false
    }
  ]
}
